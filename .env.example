# .env 템플릿 — 복사해서 .env 로 만들고 값 채우기. (.env 는 gitignore, 커밋 금지)
#   cp .env.example .env && chmod 600 .env
# 로컬: engine.* 실행 시 자동 로드(engine/env.py). 배포: docker compose 가 자동 주입.

# ── 봇 설정 ──
PRESET=presets/examples/live-strategy.json
INTERVAL=60
EQUITY=10000
COLLECT_SYMBOLS=BTCUSDC
# (선택) Discord/Slack 웹훅 — 진입/청산/에러 알림
NOTIFY_WEBHOOK=

# ── (선택) 디스코드 조회 봇 (engine.discord_bot) ──
# 슬래시 명령 /status /position /stats 로 봇 상태를 폰에서 조회. read-only(매매 못 바꿈).
# 설정법: 디스코드 개발자 포털에서 앱 생성 → Bot 토큰 발급 → OAuth2(scopes: bot, applications.commands)
#         로 서버에 초대 → 개발자모드 켜고 서버/내 계정 ID 우클릭 복사.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=                 # 이 서버(길드)에만 명령 등록 → 즉시 반영(비우면 글로벌, 최대 1시간)
DISCORD_ALLOWED_USER_IDS=         # 콤마구분 유저ID 화이트리스트. ★ 비우면 전원 거부(실돈 정보 보호)
# 알림(notify) 기본 채널. DISCORD_BOT_TOKEN 과 함께 있으면 진입/청산/에러 알림을 웹훅 대신
# 봇으로 보낸다(발신자 통일 + 버튼 부착 가능). 없으면 위 NOTIFY_WEBHOOK 폴백.
# 아래 카테고리 채널을 다 채우면 이 값은 '폴백'으로만 쓰인다(안 채운 카테고리가 여기로 감).
DISCORD_CHANNEL_ID=
# (선택) 책임별 채널 분리 — 채널 우클릭 → 'ID 복사'(개발자 모드 ON). 안 넣으면 전부 위로 감.
# 세 채널 모두 봇에게 '채널 보기 + 메시지 보내기' 권한이 있어야 한다.
DISCORD_CHANNEL_TRADES=       # → #매매      진입/청산/포지션 동기화/멈춤·재개/즉시청산/가드레일
DISCORD_CHANNEL_SYSTEM=       # → #모니터링  기동/배포/워치독(응답없음·복구)/에러/네트워크·전략·설정 전환
DISCORD_CHANNEL_DIGEST=       # → #일일일지  매일 DIGEST_HOUR 시의 지난 24시간 요약(비면 요약 OFF)
# 정기 요약 시각. 컨테이너 TZ 가 UTC 라 타임존을 명시한다(기본: 매일 오전 8시 KST).
DIGEST_HOUR=8
DIGEST_TZ=Asia/Seoul

# ── 진입 판정 로그(data/entry_log.jsonl) ──
# 폴링마다 '지금 진입되나'를 한 줄씩 쌓는다: 조건별 참/거짓, 지표 현재값, 막힌 사유.
# decided=true 는 신호봉이 닫힌 진짜 판정, false 는 그 사이 폴링의 미리보기(미완성 봉).
ENTRY_LOG_KEEP=3000           # 보관 줄 수(폴링 1분 기준 ≈이틀). 0 이면 기록 끔

# ── 워치독(데드맨 스위치, engine.watchdog) ──
# 트레이더가 조용히 멈추면(state.json 무갱신) 위 알림 경로로 경고. 별개 프로세스라 봇이 죽어도 산다.
WATCHDOG_STALE_SEC=600        # 이 초 이상 무갱신이면 '멈춤' 판정(기본 10분 = 폴 60초의 10배)
WATCHDOG_INTERVAL_SEC=120     # 확인 주기
# 멈춘 봇은 '살아 있다' — state.json 을 계속 갱신하므로 위 무갱신 감시엔 안 걸린다. 재배포로
# 되돌려진 멈춤·즉시청산 자동정지·연속손실 가드레일 래치가 전부 조용한 무매매로 남으므로,
# 원인과 무관하게 '새 진입이 오래 없다'를 시간으로 잡는다(#매매 채널로 재개 버튼과 함께).
WATCHDOG_PAUSED_ALERT_SEC=21600   # 이 초 이상 멈춤이면 1회 경고(기본 6시간, 0=끔)
# 수집 감시 — 수집기는 상태 파일을 안 남기므로 '캐시의 마지막 봉이 얼마나 뒤처졌나'로 본다.
# 디스코드 /collect 로도 같은 값을 조회한다. 일부러 멈춰둔(collector=paused) 동안은 경고 안 함.
COLLECT_STALE_MIN=10          # 마지막 봉이 이 분을 넘게 뒤처지면 '수집 멈춤' 경고
WATCH_COLLECTOR=1             # 0 이면 수집 감시 끔
# (선택·로컬 전용) 대시보드 '배포로 보내기'가 프리셋을 밀어넣을 배포 대시보드 주소.
# 기본은 SSH 터널(localhost:8080 → EC2:8080). 터널을 다른 포트로 열었으면 여기서 바꾼다.
DEPLOY_URL=http://localhost:8080

# ── 배포(ghcr 이미지) ──
IMAGE=ghcr.io/choozx/coin-coin_v2:latest

# 대시보드 노출 바인드. 기본 127.0.0.1 = loopback 전용(인터넷에 안 보임, SSH 터널로만 접근) —
# 대시보드엔 인증이 없어 실돈 제어가 그냥 열리므로 이게 안전기본값이다.
#   접속: ssh -N -L 8080:localhost:8080 <EC2>  →  http://localhost:8080
# 정말 공개로 열려면 0.0.0.0 (반드시 보안그룹에서 내 IP 만 8080 허용).
DASH_BIND=127.0.0.1

# ── 페이퍼 / 실거래 전환 ──
# 트레이더 컨테이너에 붙일 인자. 실거래로 올릴 때만 바꾼다.
#   --paper                  가짜 체결(기본)
#   --live                   진짜 주문. BINANCE_TESTNET=1 이면 테스트넷 가짜돈
#   --live --real-money      이 프로세스에 실돈 권한을 준다. BINANCE_TESTNET=0 으로 '시작'하려면
#                            필수이고, 대시보드의 테스트넷↔실돈 스위치도 이 권한이 있어야 실돈으로 간다.
#
# 권장 흐름: 아래처럼 '실돈 권한은 주되 테스트넷으로 시작' → 대시보드에서 검증 후 버튼으로 전환.
#   TRADE_MODE=--live --real-money   +   BINANCE_TESTNET=1
TRADE_MODE=--paper

# ── 실거래 키 (실거래 전까진 비워둠 → 페이퍼로만 동작) ──
# 발급 시: Enable Reading + Futures / 출금(Withdrawals) OFF / IP 화이트리스트.
#
# ★ 테스트넷과 메인넷은 다른 계정이라 키도 다르다. 둘을 오갈 거면 네트워크별로 넣을 것 —
#   아래 전용 변수를 먼저 보고, 없으면 공용 BINANCE_API_KEY/SECRET 로 폴백한다.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=
# 공용(네트워크 하나만 쓸 때). 위 전용 키가 있으면 그쪽이 이긴다.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 봇이 '시작할' 네트워크. 1=테스트넷(가짜돈), 0=메인넷(실돈).
# 값 뒤에 주석을 붙이지 말 것 — 주석은 이렇게 윗줄에.
BINANCE_TESTNET=1
# post-only 지정가를 기다리는 초(회차당). 넘으면 취소하고 새 BBO 로 재호가.
MAKER_FILL_TIMEOUT_SEC=3
# BBO 재호가(maker 추격) 횟수. 소진 후 남은 수량만 시장가(taker)로 마무리.
# 1=구 동작(한 번 걸고 안 되면 taker). 최악 대기 = MAKER_MAX_ATTEMPTS × MAKER_FILL_TIMEOUT_SEC 초.
MAKER_MAX_ATTEMPTS=5
